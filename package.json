{
  "name": "bun-reader",
  "private": true,
  "scripts": {
    "dev:server": "bun run --hot src/index.ts",
    "dev:web": "bun run --cwd web vite",
    "build": "bun run --cwd web vite build",
    "start": "bun run src/index.ts",
    "check": "bun run --cwd web vite build && tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
